local pos, len = 1, #s
local mark = 0
while pos <= len do
local q = string.find(s, "`", pos, true)
local stop = len
if q then stop = q - 1 end
for k = pos, stop do
n = n + 1
out[n] = string.sub(s, k, k)
end
if not q then break end
