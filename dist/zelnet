M.CRASH_PATH = "/.zelnet/crash.txt"
M.CONNECT_WAIT = 20
M.UPDATE_DELAY = 5
M.CRASH_REBOOT = 15
M.ADMIN_RETRY = 20
M.ADMIN_TRIES = 15
M.ADMIN_FINAL = { taken = true, bad_name = true, weak_password = true }
M.out = function(text, color)
if color and term and term.isColor and term.isColor() then term.setTextColor(color) end
