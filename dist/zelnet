if self.latch and self.near then
surf:field(ix, y, iw, "Step away and come back, or type the password.", c.warn, c.inset)
y = y + 1
end
end
y = y + 1
surf:field(ix, y, iw, "Console password:", c.text, c.inset)
page:inputBox(ix, y + 1, iw, pw, true, true)
if errMsg then surf:field(ix, y + 3, iw, errMsg, c.bad, c.inset) end
surf:field(ix, iy + ih - 1, iw, "Enter unlocks", c.dim, c.inset, "center")
surf:flush()
end
function Console:lockScreen()
self.locked = true
self.lockReq = nil
self.misses = 0
local pw, errMsg = "", nil
local timer = os.startTimer(M.SENSOR_POLL)
while true do
self:drawLock(pw, errMsg)
local ev, a = os.pullEvent()
if ev == "char" then
if #pw < 64 then pw = pw .. a end
errMsg = nil
elseif ev == "paste" and type(a) == "string" then
pw = (pw .. a):sub(1, 64)
elseif ev == "key" then
if a == keys.backspace then
pw = pw:sub(1, -2)
elseif a == keys.enter then
local now = compat.now()
if now < self.holdUntil then
errMsg = "Too many tries. Wait " .. math.ceil(self.holdUntil - now) .. " s."
elseif M.checkPassword(self.cfg, pw) then
self.fails = 0
self:unlock("password")
return "password"
else
self.fails = self.fails + 1
errMsg = "Wrong password."
if self.fails >= M.MAX_FAILS then
self:audit("unlock", nil, M.MAX_FAILS .. " bad passwords", false)
self.fails = 0
self.holdUntil = now + M.FAIL_HOLD
errMsg = "Wrong password. Locked for " .. M.FAIL_HOLD .. " s."
end
end
pw = ""
end
elseif ev == "timer" and a == timer then
timer = os.startTimer(M.SENSOR_POLL)
elseif ev == "zn_prox_unlock" then
if self.near and not self.latch then
self:unlock("proximity")
return "proximity"
end
elseif ev == "term_resize" then
self.surf:resize()
end
end
end
function Console:unlock(method)
self.locked = false
self.lockReq = nil
self.unlockedBy = method
self.misses = 0
self.lastInput = compat.now()
if self.surf.target.setCursorBlink then self.surf.target.setCursorBlink(false) end
self:audit("unlock", nil, method, true)
self.log.info("console unlocked by " .. method)
end
function Console:onSensorResult(near, note)
self.near = near and true or false
self.sensorNote = note
if not self.near then self.latch = false end
if self.locked then
if self.near and not self.latch then os.queueEvent("zn_prox_unlock") end
elseif self.unlockedBy == "proximity" then
if self.near then
self.misses = 0
else
self.misses = self.misses + 1
if self.misses >= M.SENSOR_MISSES then
self:audit("auto_lock", nil, "admin left the sensor range", true)
self:requestLock("left")
end
end
end
end
function Console:sensorTask()
local prox
while true do
local player = self.cfg.adminPlayer
if type(player) ~= "string" or player == "" then
self.sensorNote = nil
sleep(M.SENSOR_RETRY)
else
if not prox then
prox = M.findSensor()
if not prox then self.sensorNote = "no sensor attached" end
end
if prox then
local near, note = M.scanTargets(prox, player, self.cfg.adminRange)
if note == "no sensor data" then prox = nil end
self:onSensorResult(near, note)
sleep(self.locked and M.SENSOR_POLL or M.SENSOR_WATCH)
else
self:onSensorResult(false, "no sensor attached")
sleep(M.SENSOR_RETRY)
end
end
end
end
function Console:monitorTask()
while true do
local ok, err = pcall(self.drawMonitors, self)
if not ok then self.log.warn("monitor: " .. tostring(err)) end
if not self.locked then os.queueEvent("zn_console_tick") end
sleep(1)
end
end
function Console:drawMonitors()
local list = self.cfg.monitors or {}
for _, m in ipairs(list) do
if type(m) == "table" and type(m.name) == "string" and M.VIEW_TITLES[m.view] then
local s = self.monitorSurfs[m.name]
if s and not peripheral.isPresent(m.name) then s = nil end
if not s then
s = ui.attachMonitor(m.name, m.scale or self.cfg.monitorScale)
self.monitorSurfs[m.name] = s
end
if s then
local w, h = s.target.getSize()
if w ~= s.w or h ~= s.h then s:resize() end
local okDraw, derr = pcall(self.drawMonitor, self, s, m.view)
if not okDraw then
self.monitorSurfs[m.name] = nil
error(m.name .. ": " .. tostring(derr), 0)
end
end
end
end
end
function Console:drawMonitor(s, view)
local snap = self:snapshot()
local page = ui.page(s)
local c = page.c
page:header("ZelNet " .. tostring(self.cfg.realm), M.VIEW_TITLES[view])
local y, h = 3, s.h - 2
if view == "status" then
local used = M.drawCards(page, 1, y, s.w, h - 1, M.cards(c, snap, self.cfg))
local warn = (snap.status.warnings or {})[1]
if warn and y + used <= s.h then s:field(2, y + used, s.w - 2, warn, c.warn, c.bg) end
elseif view == "storage" then
M.drawStorageCards(page, 1, y, s.w, h, snap.storage)
else
M.drawNetworkView(page, 1, y, s.w, h, snap.status, self.ctx.server)
end
s:flush()
end
function M.drawStorageCards(page, x, y, w, h, info)
local c = page.c
local cards = {}
for _, r in ipairs(info or {}) do
local state = r.state or (r.present and "online" or "offline")
local cap = r.drive and 125000 or nil
cards[#cards + 1] = {
title = r.title or r.role, accent = r.present == false and c.bad or c.ok,
lines = {
{ "Drive", r.drive or "computer" },
{ "State", state, r.present == false and c.bad or c.ok },
{ "Files", tostring(r.files or 0) },
{ "Free", r.free and util.fmtBytes(r.free) or "?" },
},
used = cap and r.free and math.floor((cap - r.free) * 100 / cap) or nil,
}
end
return M.drawCards(page, x, y, w, h, cards)
end
function M.drawNetworkView(page, x, y, w, h, st, srv)
local s, c = page.s, page.c
local rows = {}
local realms = srv and srv.realms and select(2, pcall(srv.realms, srv)) or nil
if type(realms) ~= "table" then realms = {} end
for _, r in ipairs(realms) do
local label = r.realm .. (r.main and " (Main)" or "")
local right = r.realm == st.realm and "this server" or (r.reachable and ("metric " .. tostring(r.metric)) or "unreachable")
rows[#rows + 1] = { text = label, right = right, color = (r.reachable or r.realm == st.realm) and c.ok or c.bad }
end
for _, b in ipairs(st.bridges or {}) do
rows[#rows + 1] = {
text = "Bridge " .. tostring(b.peer), right = tostring(b.state) .. " q" .. tostring(b.queued or 0),
color = (b.state == "fault" or b.state == "unconfigured") and c.bad or c.accent,
}
end
local ix, iy, iw, ih = page:card(x + 1, y, w - 2, h, "Realms and bridges", c.accent)
if ix then page:list(ix, iy, iw, ih, rows, 0) end
return rows
end
function Console:dashboard()
local surf = self.surf
local timer = os.startTimer(1)
while true do
local snap = self:snapshot()
local page = ui.page(surf)
local c = page.c
page:header("Dashboard", tostring(self.cfg.realm))
local used = M.drawCards(page, 1, 3, surf.w, surf.h - 4, M.cards(c, snap, self.cfg))
local warn = (snap.status.warnings or {})[1]
if warn then surf:field(2, 3 + used, surf.w - 2, "! " .. warn, c.warn, c.bg) end
surf:field(1, surf.h, surf.w, "Ctrl or Backspace: back", c.dim, c.bg, "center")
page:hotspot(1, 1, surf.w, surf.h, "back")
surf:flush()
local ev, a, b, cc = os.pullEvent()
if ev == "timer" and a == timer then
timer = os.startTimer(1)
elseif ev == "key" and (ui.isCtrl(a) or a == keys.backspace or a == keys.enter) then
return
elseif ev == "term_resize" then
surf:resize()
elseif surf:pointer(ev, a, b, cc) then
local px, py, kind = surf:pointer(ev, a, b, cc)
if kind ~= "scroll" and page:hit(px, py) == "back" then return end
end
end
end
