items[5].hint = up .. " up"
items[6].hint = tostring(#(st.bridges or {}))
if snap.air then
items[7].hint = (snap.air.low or 0) > 0 and ((snap.air.low) .. " LOW") or tostring(snap.air.nodes or 0)
items[7].hintColor = (snap.air.low or 0) > 0 and c.bad or nil
else
items[7].hint = "off"
end
