ln = v - 39
dist = a * 8100 + b * 90 + c
pos = q + 5
end
local from = n - dist
for k = 1, ln do
n = n + 1
out[n] = out[from + k]
end
end
if n - mark > 20000 then
mark = n
breathe()
end
end
return table.concat(out)
