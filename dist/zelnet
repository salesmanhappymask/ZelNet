local function U(s)
local out, n = {}, 0
local pos, len = 1, #s
local mark = 0
while pos <= len do
local q = string.find(s, "`", pos, true)
local stop = len
if q then stop = q - 1 end
for k = pos, stop do
n = n + 1
out[n] = string.sub(s, k, k)
end
if not q then break end
local c2 = string.byte(s, q + 1)
if c2 == 96 then
n = n + 1
out[n] = "`"
pos = q + 2
else
local v = V[c2]
local a = V[string.byte(s, q + 2) or 0]
local b = V[string.byte(s, q + 3) or 0]
local ln, dist
if v < 45 then
ln = v + 5
dist = a * 90 + b
pos = q + 4
else
local c = V[string.byte(s, q + 4) or 0]
ln = v - 39
dist = a * 8100 + b * 90 + c
pos = q + 5
end
local from = n - dist
for k = 1, ln do
n = n + 1
out[n] = out[from + k]
end
end
if n - mark > 20000 then
mark = n
breathe()
end
end
return table.concat(out)
end
