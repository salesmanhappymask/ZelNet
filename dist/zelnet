local function U(s)
local out, n = {}, 0
local pos, len = 1, #s
local mark = 0
while pos <= len do
local q = string.find(s, "`", pos, true)
local stop = len
if q then stop = q - 1 end
for k = pos, stop do
n = n + 1
out[n] = string.sub(s, k, k)
end
if not q then break end
local c2 = string.byte(s, q + 1)
if c2 == 96 then
n = n + 1
out[n] = "`"
pos = q + 2
else
local v = V[c2]
